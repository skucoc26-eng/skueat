# ==============================================================================
# skueat 서비스 환경 변수 템플릿
# ==============================================================================
# 로컬 개발 시 이 파일을 복사하여 .env 파일을 생성하세요:
# cp .env.example .env

# [필수] 카카오 개발자 콘솔(https://developers.kakao.com) 설정
# - KAKAO_API_KEY: JavaScript 키 (프론트엔드 카카오맵 지도 렌더링에 사용)
KAKAO_API_KEY=your_kakao_javascript_key_here

# - REST_API_KEY: REST API 키 (백엔드 카카오 소셜 로그인 OAuth2 토큰 발급에 사용)
REST_API_KEY=your_kakao_rest_api_key_here

# [선택] 서비스 도메인 및 서버 네트워크 설정
# 카카오 로그인 Redirect URI는 "${APP_DOMAIN}/auth/kakao/callback" 형태로 자동 구성됩니다.
# 카카오 디벨로퍼스에 해당 Redirect URI가 반드시 등록되어 있어야 합니다.
APP_DOMAIN=http://localhost:8080
APP_HOST=0.0.0.0
APP_PORT=8080

# [필수/보안] 세션 쿠키 암호화 시크릿 키
# 운영 배포 시 반드시 충분히 길고 유니크한 임의의 문자열로 변경하세요.
SESSION_SECRET=change_this_to_a_secure_random_string_in_production

# [선택] SQLite 데이터베이스 파일 저장 경로
DATABASE_PATH=restaurants.db
